# --- Frontend -------------------------------------------------------------
# Where the frontend sends its API calls.
# Empty (or unset) = the API bundled with this app, on the same origin.
# Point it at the Narzo 50A Node.js server when that is running:
# VITE_API_BASE_URL="http://192.168.1.42:3000"
VITE_API_BASE_URL=""

# --- Server (local SQLite + filesystem storage) ----------------------------
# Directory holding the database and the stored file bodies.
# Default: ./.vault-data next to the project.
# Windows example:  VAULT_DATA_DIR="D:\\vault-data"
# Termux example:   VAULT_DATA_DIR="/data/data/com.termux/files/home/vault-data"
VAULT_DATA_DIR=""

# Optional explicit path of the SQLite database file.
# Default: <VAULT_DATA_DIR>/vault.db
VAULT_DB_PATH=""
